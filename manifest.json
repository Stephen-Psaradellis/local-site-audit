{
  "manifest_version": 3,
  "name": "Local Site Audit + Pitch",
  "short_name": "Site Audit + Pitch",
  "version": "0.1.4",
  "description": "One click on any small-business website: a client-ready audit of real defects with evidence, plus a pitch email written from them.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Audit this site",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "local-site-audit@shortforge.dev",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
